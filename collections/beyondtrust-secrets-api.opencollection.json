{
  "opencollection": "1.0.0",
  "info": {
    "name": "BeyondTrust Password Safe Authentication Secrets API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BeyondTrust List Secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}/BeyondTrust/api/public/v3/secrets-safe/secrets",
            "params": [
              {
                "name": "title",
                "value": "database-credentials",
                "type": "query",
                "description": "Filter secrets by title."
              }
            ]
          },
          "docs": "Returns a list of secrets from the secrets safe store."
        },
        {
          "info": {
            "name": "BeyondTrust Create Secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{hostname}/BeyondTrust/api/public/v3/secrets-safe/secrets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new secret in the secrets safe store."
        },
        {
          "info": {
            "name": "BeyondTrust Get Secret",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}/BeyondTrust/api/public/v3/secrets-safe/secrets/:id",
            "params": [
              {
                "name": "id",
                "value": "secret-a1b2c3",
                "type": "path",
                "description": "The unique identifier of the secret."
              }
            ]
          },
          "docs": "Returns a single secret by ID including its value."
        },
        {
          "info": {
            "name": "BeyondTrust Delete Secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{hostname}/BeyondTrust/api/public/v3/secrets-safe/secrets/:id",
            "params": [
              {
                "name": "id",
                "value": "secret-a1b2c3",
                "type": "path",
                "description": "The unique identifier of the secret."
              }
            ]
          },
          "docs": "Deletes a secret from the secrets safe store."
        }
      ]
    }
  ],
  "bundled": true
}