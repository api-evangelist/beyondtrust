{
  "opencollection": "1.0.0",
  "info": {
    "name": "BeyondTrust Password Safe Authentication Managed Systems API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Managed Systems",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BeyondTrust List Managed Systems",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}/BeyondTrust/api/public/v3/managedsystems",
            "params": [
              {
                "name": "name",
                "value": "prod-server-01",
                "type": "query",
                "description": "Filter by system name."
              }
            ]
          },
          "docs": "Returns a list of managed systems registered in Password Safe."
        }
      ]
    }
  ],
  "bundled": true
}