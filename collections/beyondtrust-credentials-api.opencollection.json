{
  "opencollection": "1.0.0",
  "info": {
    "name": "BeyondTrust Password Safe Authentication Credentials API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BeyondTrust Get Request Credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}/BeyondTrust/api/public/v3/requests/:requestId/credentials",
            "params": [
              {
                "name": "requestId",
                "value": "1001",
                "type": "path",
                "description": "The unique identifier of the approved request."
              }
            ]
          },
          "docs": "Retrieves the credentials for an approved access request."
        }
      ]
    }
  ],
  "bundled": true
}